#!/usr/bin/env bash
# Refuse a commit that does not build, or whose tests do not pass.
#
# Installed via `git config core.hooksPath tools/hooks` (tools/install_hooks.sh
# does it). Committed to the repo rather than living in .git/hooks so it is the
# same on every machine ~/pockt syncs to.
#
# Runs `build_all.sh --quick`: the core configuration with tests ON, which is
# what a commit can actually break on a laptop. The provider configurations and
# the goldens need libibverbs / CUDA / MareNostrum, so they stay with
# tools/build_all.sh (no --quick) and tests/hpc/run_on_mn5.sh.
#
#   git commit --no-verify     # skip it, when you know what you are doing
#
# It is incremental — the tree in build-all/core is reused — so the usual cost
# is a few seconds, not a full rebuild.
set -uo pipefail

root="$(git rev-parse --show-toplevel)"

# Docs-only commits cannot break a build; do not make people wait for one.
# No --diff-filter: a commit that only DELETES a source file must still build
# (a removed header breaks every includer, and D was once excluded here).
if ! git diff --cached --name-only |
     grep -qvE '\.(md|golden|sql|json)$|^plans/|^docs/'; then
  echo "pre-commit: docs/goldens only, skipping the build gate"
  exit 0
fi

# ── Formatting ─────────────────────────────────────────────────────────────
# Self-enabling, on purpose. While any first-party file is still unformatted,
# this does nothing: formatting whole files on the way past would bury real
# changes under thousands of reformatted lines, and would collide with any work
# in progress on another branch or worktree.
#
# Run `tools/format.sh --all` once, commit that normalization on its own, and
# from then on this branch is clean and the hook starts holding it that way —
# no flag to set and nothing to remember. Costs ~0.8 s.
if "$root/tools/format.sh" --check --all >/dev/null 2>&1; then
  "$root/tools/format.sh" >/dev/null || {
    echo "pre-commit: REFUSED — clang-format failed" >&2; exit 1; }
fi

# ── CLI call sites ─────────────────────────────────────────────────────────
# A script that calls `pcomm` with a flag where the verb goes still "runs" — it
# exits 2 with a message no job.sbatch reads, and the failure surfaces as rc=2 a
# queue slot later. 30 ms here, one cluster run there.
# stdout is the "ok" line and is silenced; the offending lines go to stderr.
"$root/tools/check_cli_callsites.sh" >/dev/null || {
  echo "pre-commit: REFUSED — fix the call sites above" >&2; exit 1; }

echo "pre-commit: building core config + tests (tools/build_all.sh --quick)"
if "$root/tools/build_all.sh" --quick > "$root/build-all/pre-commit.log" 2>&1; then
  echo "pre-commit: ok"
  exit 0
fi

echo
echo "pre-commit: REFUSED — the tree does not build or its tests fail."
echo
tail -30 "$root/build-all/pre-commit.log"
echo
echo "full log: build-all/pre-commit.log"
echo "re-run:   tools/build_all.sh --quick"
echo "override: git commit --no-verify"
exit 1

// Canonical on-disk schema for pcomm record streams.
//
// A `.pcs` file is a 32-byte StreamHeader followed by a packed array of one of
// the record structs below — no per-record framing, no vtables. These are
// FlatBuffers **structs**, not tables: fixed layout, inline, no offsets, so they
// are byte-for-byte what the C++ recorder writes. Measured: writing them costs
// 9.48 ns/record against 10.13 for the hand-written POD, i.e. free, and the
// sizes are identical. The header is written once per file, not per record, so
// it costs nothing on the hot path at all.
//
// Why a schema at all, if the layout is unchanged: it makes the layout
// *defined* rather than a consequence of compiler padding, and it lets other
// languages read captures via flatc codegen — demonstrated, not assumed, by
// tools/read_pcs.py, which reads a real capture from Python and reproduces
// case 01's goldens.
//
// FlatBuffers also *supports* reflection. We do not use it and do not count it
// as a benefit: see gap 7 in plans/PLAN-20260730-1900-flatbuffers-gaps-done.md
// for why a reflection-driven dumper was rejected. Listing a benefit nothing
// collects is how the portability claim went four weeks unexercised.
//
// The binding between these definitions and the C++ structs is enforced by
// tests/schema_conformance — if a record changes and the schema does not, the
// build fails rather than silently writing files nobody can parse.
//
// Structs cannot gain fields, so a record's layout is frozen once a capture
// holds it. Evolving one means a new record type in the same family: same wire
// name, next version, next free type_id in the provider's range (ibverbs
// 100-199, internal 500-599, gpumem 700-799). See PCOMM_RECORD_V in
// pcomm/core/record.hpp for the convention and pcomm/rec/version_map.hpp for
// how a reader serves captures from both sides of a bump.
//
// PRE-ALPHA EXCEPTION, and it is a deliberate project decision rather than an
// oversight: while no capture outlives the commit that wrote it, a field is
// added in place and kSchemaHash is bumped, instead of minting a version and
// carrying two readers forever. IbMemRegion.dmabuf_fd was added this way. The
// versioning machinery stays because the moment captures outlive a release this
// stops being free — and the schema hash is what makes the break loud: an old
// capture fails the header check instead of misparsing.

namespace pcomm.fb;

// --- shared vocabulary -----------------------------------------------------

// These enums mirror pcomm/core/vocab.hpp and pcomm/core/time.hpp. They are
// declared here rather than described in a comment on purpose: a reordered C++
// enumerator changes no size and no field offset, so the byte-level
// conformance test cannot see it, and prose cannot be checked at all. Declared
// this way, tests/schema_conformance static_asserts every value against its C++
// counterpart. Do not renumber — the values are on disk.

enum TimeKind : uint8 { None = 0, Instant = 1, Interval = 2, Window = 3, Counter = 4 }

// What a record type *is*, from pcomm/core/ids.hpp. On disk since the stream
// header carries it.
enum RecordKind : uint8 { Event = 0, Entity = 1, Artifact = 2, Edge = 3 }

enum MemOp : uint8 { Load = 0, Store = 1, Atomic = 2, Prefetch = 3 }

enum MemSpace : uint8 { Global = 0, Local = 1, Shared = 2 }

// What a CudaMemcpy moved, as the API was ASKED for it. See core/vocab.hpp for
// why this is deliberately not the edge test — a DeviceToDevice copy under
// unified addressing can cross a device boundary, so the derived layer keys on
// src_device <> dst_device and never on this.
enum MemcpyKind : uint8 {
  Unknown = 0,
  HostToDevice = 1,
  DeviceToHost = 2,
  DeviceToDevice = 3,
  HostToHost = 4,
  PeerToPeer = 5,
  HostToArray = 6,
  ArrayToHost = 7,
  ArrayToArray = 8,
  ArrayToDevice = 9,
  DeviceToArray = 10,
}

// What kind of allocation one end of a copy is. NOT MemSpace above, which is an
// instruction's SASS address space; this is the allocation class, and Pageable
// vs Pinned is the reason it is recorded at all.
enum MemResidency : uint8 {
  Unknown = 0,
  Pageable = 1,
  Pinned = 2,
  Device = 3,
  Array = 4,
  Managed = 5,
  DeviceStatic = 6,
  ManagedStatic = 7,
}

// Which instrument produced a CudaMemcpy's [a, b]. HostApi has no producer yet;
// see core/vocab.hpp for why it is declared before it exists.
enum CopySource : uint8 { Cupti = 0, HostApi = 1 }

// Predicates for Edge records.
enum EdgePredicate : uint8 {
  TouchedObject = 0,     // access -> mem object
  MapsToSourceLine = 1,  // pc -> source line
  ResidesOn = 2,         // object -> device
  MapsToQp = 3,          // endpoint -> queue pair
}

struct TimePoint { domain:uint16; ticks:uint64; }          // 16 B

struct Temporal {
  kind:TimeKind;
  a:TimePoint;      // instant / interval.start / window.lo / counter.t
  b:TimePoint;      // interval.end / window.hi
  value:uint64;     // counter value
}                                                          // 48 B

struct MemRange { base:uint64; size:uint64; }              // 16 B

// --- file framing ----------------------------------------------------------

// The first 32 bytes of every `.pcs`. Before this existed a capture was a bare
// array: which record type it held came from the *filename*, and which schema
// wrote it came from nowhere at all. A file written before a schema change was
// indistinguishable from one written after, so a reader that guessed wrong
// misparsed silently — no magic to check, no stride to disagree with, nothing.
//
// 32 B keeps the records that follow 8-byte aligned. Written once when the file
// is created, so it costs nothing per record.
//
// `magic` is 0x0A534D4D4F435089 — the bytes 89 'P' 'C' 'O' 'M' 'M' 'S' 0A, in
// that order on disk. Read back as a little-endian uint64 it equals the
// constant; on a big-endian reader, or through anything that mangles a byte, it
// does not, which is the point.
//
// `schema_hash` identifies *this file's* pcomm.fbs: FNV-1a over the schema with
// comments stripped and whitespace collapsed, so prose edits do not churn it.
// tools/schema_check.py recomputes it and fails the build if the constant in
// pcomm/rec/stream_header.hpp has drifted.
struct StreamHeader {
  magic:uint64;
  format_version:uint16;   // 1
  type_id:uint16;          // which record struct follows
  stride:uint32;           // bytes per record, i.e. sizeof(Stamped<R>)
  schema_hash:uint64;
  kind:RecordKind;
}                                                          // 32 B

// The header of `intern-blob.bin`, the byte heap the interned strings point
// into. Same idea as StreamHeader and for the same reason: the blob is useless
// on its own and catastrophic if paired with the wrong capture — every string
// in every record would resolve to the wrong text, with nothing out of place to
// notice. 32 B, written once.
//
// magic is 0x0A424F4C42435089 — the bytes 89 'P' 'C' 'B' 'L' 'O' 'B' 0A.
struct BlobHeader {
  magic:uint64;
  format_version:uint16;   // 1
  byte_count:uint64;       // payload bytes following this header
  schema_hash:uint64;
}                                                          // 32 B

// --- core records ----------------------------------------------------------

// type 700, Event. The GPU-access firehose.
struct GpuAccess {
  temporal:Temporal;
  pc:uint32;           // interned handle
  object:uint32;       // interned handle, 0 = unattributed
  address:uint64;
  launch:uint64;       // GpuKernel.correlation, same rank; 0 = unknown
  size:uint32;
  op:MemOp;
  space:MemSpace;
  run_device:uint16;
  mem_device:uint16;
  thread:uint32;
}

// type 740, Artifact. One PC -> source location row.
struct SourceLine {
  temporal:Temporal;
  pc:uint32;
  file:uint32;         // interned path
  line:uint32;
}

// type 760, Edge. Generic attribution row.
struct Attribution {
  temporal:Temporal;
  subject:uint32;
  object:uint32;
  pred:EdgePredicate;
}

// type 510, Artifact. One interned numeric value (pc, pointer). The dictionary
// behind every Handle; see pcomm/core/records.hpp for why it is a record.
struct InternKey {
  temporal:Temporal;
  key:uint64;
  handle:uint32;
  domain:uint8;
}

// type 512, Artifact. One interned string, as (offset, length) into
// intern-blob.bin. The bytes cannot live in the record: a record is a
// fixed-stride array element.
struct InternString {
  temporal:Temporal;
  offset:uint64;
  length:uint32;
  handle:uint32;
  domain:uint8;
}

// type 520, Entity. A memory object with lifetime [alloc, free). In the
// internal range rather than gpumem's, because any provider holding an address
// may emit one — see core/records.hpp.
struct MemObject {
  temporal:Temporal;
  id:uint32;
  name:uint32;         // interned symbol/type name
  range:MemRange;
  device:uint16;
}

// type 522, Event. An entity's lifetime ended — dereg_mr, destroy_qp,
// devx_umem_dereg, devx_free_uar. One shared type for every provider, because
// `subject` is an interned handle and those are unique across providers. See
// core/records.hpp for why this is a separate record rather than a window
// back-filled into the open record.
struct EntityClose {
  temporal:Temporal;
  subject:uint32;      // the interned handle the open record carries
  opener:uint16;       // type_id of the record that should have opened it
}

// type 524, Artifact. Which machine this rank ran on — FNV-1a of the hostname.
//
// A device ordinal is node-local, so `run_device 0` on two nodes is two
// different GPUs. Resolving a peer device to a rank needs (node, device), and
// this is the node half. The reader falls back to grouping ranks by HCA LID
// when this record is absent, which works only where InfiniBand exists.
struct NodeIdentity {
  temporal:Temporal;
  node_hash:uint64;
}

// type 528, Artifact. What a device ORDINAL actually refers to, on this rank.
//
// An ordinal is node-local (see NodeIdentity above) and ALSO remap-local:
// CUDA_VISIBLE_DEVICES renumbers per process, so ranks each pinned to their own
// GPU can all report device 0. `pci_bus` fixes the remap half and not the node
// half — measured on MN5 job 45280114, four nodes of identical hardware, where
// bus ids 1B/2C/9D/AD repeat exactly across every node. So the identity is
// (NodeIdentity.node_hash, pci_bus), and pci_bus alone is actively wrong.
//
// uuid_hi/uuid_lo are the 16 raw bytes of cuDeviceGetUuid and are a CROSS-CHECK,
// never the key: they come back zero-filled or near-sequential under vGPU, some
// container runtimes and older drivers, and a degenerate UUID is worse than an
// absent one because it merges nodes while looking authoritative. 0,0 means
// unavailable. Not MIG-aware by decision — a MIG instance shares its parent's
// UUID with every sibling, and MIG is Disabled on every GPU measured, so that
// path would ship untested.
//
// One row per VISIBLE device, not per used device. It is a catalogue, and is
// deliberately not what rank_identity.device reads — that answers which GPU a
// rank drove, from evidence of use.
struct GpuDevice {
  temporal:Temporal;
  uuid_hi:uint64;
  uuid_lo:uint64;
  pci_bus:uint32;
  name:uint32;
  ordinal:uint16;
}

// type 532, Artifact. What this rank was ASKED to do, and by which build.
//
// Every other record says what the application did. None said what the TRACER
// was told to do, which left a capture unable to describe itself. Two MN5 jobs
// — 45329318 and 45330017 — differ only in mpirun's `--map-by`, produce
// measurably different traffic, and nothing inside either capture says which is
// which. The placement is recoverable from node_identity plus rank, but the
// REQUEST that produced it was recorded nowhere.
//
// `images` is the other half, and it has a scar. Job 45331793 reported
// uct_binding.accepted = 0 on a UCX the guard had just been widened to admit,
// and read as a clean refutation of the change. It was not: that job loads
// .so files hand-copied into a second directory, and the copy was two hours
// stale while the build tree beside it was correct. There were six UCX build
// directories on that machine. So this walks /proc/self/maps at emit time and
// records every mapped libpcomm object with its size and mtime — no cooperation
// from providers, no ABI change, and it answers "which file actually answered"
// for the engine and every provider at once.
//
// `build` is the compile-time counterpart: commit, dirty flag, build type,
// engine ABI. Regenerated on every build rather than at configure time — a
// build id that only refreshes when someone re-runs cmake is precisely the
// stale-provenance failure this field exists to catch.
//
// `env` is an allowlist, not the environment. Prefix PCOMM_, plus the launcher
// variables that decide placement (SLURM_*, OMPI_MCA_rmaps_*, CUDA_VISIBLE_DEVICES,
// LD_PRELOAD). Extend it with PCOMM_ENV_CAPTURE. A whole environ would put
// credentials in every capture and is not worth it for the two variables that
// matter.
//
// One row per rank. All five payload fields are interned strings, so unlike
// NodeIdentity and ClockAnchor this record CANNOT be part of the early flush —
// its handles are undefined until the dictionary is written at teardown.
struct Invocation {
  temporal:Temporal;
  argv:uint32;
  env:uint32;
  providers:uint32;
  build:uint32;
  images:uint32;
  pid:uint32;
}

// type 526, Entity. One process's mapping of a shared allocation, keyed by an
// identity both sides agree on.
//
// `allocation` is the interned CUmemFabricHandle (hex), which is globally
// meaningful by construction — the exporter's row and the importer's row mint
// the same id from the same 64 bytes, and that join is the only way to turn a
// peer access address into the owner's address. Written for
// CU_MEM_HANDLE_TYPE_FABRIC only: a POSIX fd names the driver node rather than
// the allocation (measured, MN5 job 44705498 — all 48 exports and imports share
// dev=6 ino=1729) and its number is process-local besides.
//
// `alloc_offset` is cuMemMap's own offset argument, so partial maps work rather
// than being assumed away. See core/records.hpp for the address arithmetic.
struct PeerMapping {
  temporal:Temporal;
  allocation:uint32;
  range:MemRange;
  alloc_offset:uint64;
  device:uint16;
  exporter:uint8;
}

// type 530, Event. One kernel's EXECUTION window on the device.
//
// In the internal range rather than the reserved cupti 300s because that range
// names an instrument and this record has two: NVBit takes the process's only
// CUPTI subscriber slot, so a capture with gpumem loaded must get the same fact
// from an injected globaltimer instead. `source` says which. See
// core/records.hpp and core/vocab.hpp's KernelSource.
//
// [a, b] is EXECUTION. Submission is a different quantity — 9-13 ms away from
// it on kernels lasting 11-20 us — and is only ever present as
// source = HostSubmit.
struct GpuKernel {
  temporal:Temporal;
  correlation:uint64;  // joins submission to execution; 0 when unavailable
  stream:uint64;       // CUstream
  name:uint32;         // interned demangled symbol
  grid_x:uint32;
  grid_y:uint32;
  grid_z:uint32;
  device:uint16;
  block_x:uint16;
  block_y:uint16;
  block_z:uint16;
  source:uint8;        // KernelSource: which instrument produced [a, b]
}

// type 534, Event. One host-initiated memory COPY, [a, b] on the copy engine.
//
// The record for traffic no other stream in a capture can see: a copy engine
// retires no instruction (so gpumem/NVBit is structurally blind to it), posts no
// work request, and calls into neither UCX nor NCCL. cudaMemcpyPeer between two
// GPUs is COMMUNICATION and had no lane until this existed.
//
// In the internal range beside GpuKernel and not in the reserved cupti 300s, for
// GpuKernel's reason applied one step further out: a second instrument for this
// fact (interposing cudaMemcpy*/cuMemcpy*) needs no CUPTI subscriber and is
// exactly what would work under gpumem, where CUPTI is refused. `source` says
// which produced [a, b].
//
// NO ADDRESSES, and that is the door's limit rather than a choice:
// CUpti_ActivityMemcpy6 and CUpti_ActivityMemcpyPtoP4 have no pointer-valued
// field at all. So object_access cannot place this traffic. See
// core/records.hpp.
//
// `ctx_device` is CUPTI's own `deviceId` — whose CONTEXT the copy was issued in,
// reported on the peer record too. It is the ONLY sound ownership evidence a
// copy carries: a peer copy names one device the rank owns and one it does not,
// and nothing on the row says which. Measured on du04 — four MPI ranks
// cudaMemcpyPeer'ing round an IPC ring produced a perfect device-space matrix
// and a comm_edges of one `-1 -> -1` edge, because no other record in that
// capture said which rank drove which GPU. See core/records.hpp.
//
// src_device/dst_device are 65535 (kUnknownDevice) for a host end, and CARRY THE
// SAME ORDINAL on both sides of a non-peer copy — CUPTI's non-peer record has
// one deviceId. That is what makes `src_device <> dst_device` a sound edge test:
// a row claims two devices only when CUPTI reported two.
struct CudaMemcpy {
  temporal:Temporal;
  correlation:uint64;  // CUPTI correlationId — GpuKernel/GpuAccess's id space
  bytes:uint64;
  stream:uint64;       // stream ORDINAL, as GpuKernel.stream
  src_device:uint16;   // 65535 = host memory
  dst_device:uint16;
  ctx_device:uint16;   // whose CONTEXT issued it — the ownership field
  kind:MemcpyKind;         // what the API was asked for
  src_space:MemResidency;  // pageable / pinned / device / managed ...
  dst_space:MemResidency;
  source:CopySource;   // which instrument produced [a, b]
  async:uint8;         // 1 = issued through an asynchronous entry point
}

// type 590, Artifact. Clock-domain calibration anchor.
struct ClockAnchor {
  temporal:Temporal;
  domain:uint16;
  local_ticks:uint64;  // domain clock (TSC / GPU globaltimer)
  wall_ns:uint64;      // CLOCK_REALTIME at the same moment
  mono_ns:uint64;      // CLOCK_MONOTONIC_RAW at the same moment
}

// type 592, Artifact. Whether this rank's capture is COMPLETE. One row per rank,
// written only by a normal finalize(), so a rank present in clock_anchor and
// absent here started and did not finish — see the C++ declaration in
// libpcomm/include/pcomm/core/records.hpp for why absence carries more than any
// field below, and for the measurement that made the case for the record.
struct CaptureStatus {
  temporal:Temporal;
  records_lost:uint64;  // rounded UP; a partially written record is a lost one
  bytes_lost:uint64;
  streams_open:uint32;  // streams framed, INCLUDING this record's own stream
  streams_lost:uint32;
  dir_failed:uint8;
  header_lost:uint8;
  never_opened:uint8;
  pad:uint8;
  pad2:uint32;
}

// --- ibverbs provider records (100-199) ------------------------------------

// type 100, Entity. A registered memory region, lifetime [reg, dereg).
struct IbMemRegion {
  temporal:Temporal;
  mr:uint32;
  pd:uint32;
  range:MemRange;
  lkey:uint32;
  rkey:uint32;
  access:uint32;
  dmabuf_fd:int32;     // -1 unless registered via ibv_reg_dmabuf_mr
  origin:uint8;        // IbRegionOrigin: which door registered it
}

// type 102, Entity. A queue-pair endpoint, lifetime [create, destroy).
struct IbQueuePair {
  temporal:Temporal;
  qp:uint32;
  pd:uint32;
  qp_num:uint32;
  qp_type:uint8;
}

// type 126, Artifact. A queue pair's signalling policy (ibv_qp_init_attr
// .sq_sig_all). sq_sig_all = 1 certifies that every work request on this queue
// pair completes, which is the precondition that makes Nth-send-to-Nth-
// completion matching exact. Additive rather than a field on IbQueuePair: a
// layout is immutable once a capture holds it. See ib_records.hpp.
struct IbQpSignalling {
  temporal:Temporal;
  qp:uint32;
  qp_num:uint32;
  sq_sig_all:uint8;
}

// type 104, Entity. A completion queue, lifetime [create, destroy). The entity
// IbPollCq.cq has referenced since ib_poll_cq existed, and which nothing
// created until now. Hangs off a CONTEXT rather than a PD — the one ibverbs
// object that can exist before any protection domain does.
struct IbCompletionQueue {
  temporal:Temporal;
  cq:uint32;
  context:uint32;
  channel:uint32;      // ibv_comp_channel*, 0 when the CQ has none
  cqe:uint32;          // depth the device granted, not the depth requested
  comp_vector:uint32;
  origin:uint8;        // IbCqOrigin: which door created it
}

// type 106, Event. A QP state transition; ->RTR carries the remote endpoint,
// which is what makes the connection topology recoverable.
struct IbModifyQp {
  temporal:Temporal;
  qp:uint32;
  qp_num:uint32;
  dest_qp_num:uint32;
  dest_lid:uint32;
  src_lid:uint32;      // our own port's LID; (src_lid, qp_num) names a QP uniquely
  state:uint8;
}

// type 108, Entity. A shared receive queue, lifetime [create, destroy). The
// entity IbPostRecv rows of origin `srq` name. Depths are the device's answers
// (ibv_query_srq), not the caller's request.
struct IbSharedRecvQueue {
  temporal:Temporal;
  srq:uint32;
  pd:uint32;
  max_wr:uint32;
  max_sge:uint32;
  srq_limit:uint32;
}

// type 110, Event. One posted work request. The network firehose.
struct IbPostSend {
  temporal:Temporal;
  qp:uint32;
  wr_id:uint64;
  remote_addr:uint64;
  rkey:uint32;
  length:uint32;
  qp_num:uint32;
  send_flags:uint32;
  opcode:uint8;
  num_sge:uint8;
}

// type 128, Event. One scatter-gather entry of a posted send — the LOCAL
// buffer, which IbPostSend does not keep (it sums the lengths). Full mode only:
// one row per SGE against one per work request. Joins back on
// (rank, qp_num, wr_id, temporal_a_ticks); the ticks are required because wr_id
// is caller-chosen and routinely constant. See ib_records.hpp.
struct IbPostSendSg {
  temporal:Temporal;
  qp:uint32;
  wr_id:uint64;
  addr:uint64;
  length:uint32;
  lkey:uint32;
  qp_num:uint32;
  index:uint8;
}

// type 114, Event. One posted receive (ibv_post_recv / ibv_post_srq_recv).
// addr/lkey are the first sge's, and they are what resolves the receive buffer
// to an ib_mem_region — the question the capture could not answer at all before
// this record existed.
struct IbPostRecv {
  temporal:Temporal;
  subject:uint32;      // ibv_qp* or ibv_srq*, per origin
  wr_id:uint64;
  addr:uint64;         // first sge's addr; 0 when num_sge == 0
  lkey:uint32;         // first sge's lkey; joins to IbMemRegion.lkey
  length:uint32;       // total sg_list bytes — capacity offered, not bytes received
  first_len:uint32;    // sge[0]'s own length; byte_len > this means it spilled
  qp_num:uint32;       // 0 when origin is SharedRecvQueue
  slot:uint32;         // SRQ ring index this WQE took; 0xFFFFFFFF = unknown
  num_sge:uint8;
  origin:uint8;        // IbRecvOrigin: which door posted it
}

// type 118, Entity. A UD address handle, lifetime [create, destroy). Carries
// the destination a UD send is aimed at — which lives nowhere else in the API,
// because UD's RTR transition names no peer the way RC's does.
struct IbAddressHandle {
  temporal:Temporal;
  ah:uint32;
  pd:uint32;
  dgid_prefix:uint64;  // host order, like Mlx5DevxQpConnect
  dgid_iface:uint64;
  flow_label:uint32;
  dlid:uint32;
  sl:uint8;
  port_num:uint8;
  is_global:uint8;     // whether the GRH fields above mean anything
  sgid_index:uint8;
  hop_limit:uint8;
  traffic_class:uint8;
}

// type 122, Entity. One physical port and its LID, from ibv_query_port at
// device open. Exists so a rank that never transitions a queue pair still has a
// LID — ib_modify_qp.src_lid is otherwise the only source, and it requires
// traffic. See ib_records.hpp.
struct IbPort {
  temporal:Temporal;
  context:uint32;
  lid:uint32;
  port_num:uint8;
  state:uint8;
}

// type 120, Entity. The HCA behind one ibv_context. node_guid is the globally
// unique name a LID only approximates.
struct IbDevice {
  temporal:Temporal;
  context:uint32;
  fw_ver:uint32;         // interned string
  node_guid:uint64;      // host order
  sys_image_guid:uint64;
  vendor_id:uint32;
  vendor_part_id:uint32;
  hw_ver:uint32;
  phys_port_cnt:uint8;
}

// type 116, Event. A CQ armed for a completion notification. The only evidence
// that an application sleeps on interrupts rather than spinning on poll_cq.
struct IbReqNotifyCq {
  temporal:Temporal;
  cq:uint32;
  solicited_only:uint8;
}

// type 112, Event. One completion drained from a CQ.
struct IbPollCq {
  temporal:Temporal;
  cq:uint32;
  wr_id:uint64;
  byte_len:uint32;
  qp_num:uint32;
  status:uint8;
  opcode:uint8;
}

// type 124, Event. The CQE's own account of a receive completion. Present only
// where the raw mlx5 CQE was read AND agreed with the ibv_wc beside it, so a
// row is an assertion that the hardware named this WQE.
struct IbRecvCqe {
  temporal:Temporal;
  cq:uint32;
  wr_id:uint64;
  srq:uint32;
  wqe_counter:uint32;
  qp_num:uint32;
  byte_len:uint32;
}

// --- mlx5dv/DEVX provider records (200-299) --------------------------------
//
// The control plane IBGDA uses instead of verbs. A GPU-initiated NVSHMEM run
// creates its queue pairs with mlx5dv_devx_obj_create and connects them with
// mlx5dv_devx_obj_modify, so nothing in the 100-range above sees any of it.

// type 200, Entity. A buffer handed to the NIC, lifetime [reg, dereg).
// `range.base` is 0 when binding == ByDmabuf: the buffer is named by file
// descriptor and the address field is an offset, not a pointer.
struct Mlx5Umem {
  temporal:Temporal;
  umem:uint32;
  range:MemRange;
  umem_id:uint32;
  access:uint32;
  dmabuf_fd:int32;     // -1 unless binding == ByDmabuf
  device:uint16;       // owning GPU, or 0xFFFF for unknown (NOT 0 — 0 is real)
  binding:uint8;       // UmemBinding: 0 = ByAddress, 1 = ByDmabuf
  entry:uint8;         // UmemEntry: 0 = umem_reg, 1 = umem_reg_ex
}

// type 202, Entity. A User Access Region — the doorbell page a GPU writes to
// in order to tell the NIC a work-queue entry is ready.
struct Mlx5Uar {
  temporal:Temporal;
  uar:uint32;
  reg_addr:uint64;
  base_addr:uint64;
  page_id:uint32;
  flags:uint32;
}

// type 204, Event. One DEVX command, decoded or not. Recorded even when this
// build does not know the opcode, so a version boundary is visible in the
// capture rather than silently absent from it.
struct Mlx5DevxCmd {
  temporal:Temporal;
  obj:uint32;
  opcode:uint32;
  decoded:uint8;
}

// type 206, Entity. A DEVX queue pair — the GPU-initiated counterpart of
// IbQueuePair. sq_base + log_sq_size locate the send queue the GPU writes into.
struct Mlx5DevxQp {
  temporal:Temporal;
  obj:uint32;
  sq_base:uint64;
  qp_num:uint32;
  wq_umem_id:uint32;   // joins to Mlx5Umem.umem_id
  log_sq_size:uint32;
  device:uint16;
  service_type:uint8;  // mlx5 transport service type (0x5 = DCI)
  gpu_driven:uint8;
}

// type 208, Event. The ->RTR transition, carrying the remote endpoint. Same
// role as IbModifyQp's RTR row, and carries src_lid for the same reason:
// qp_num is per-HCA and collides across nodes, so (src_lid, qp_num) is what
// names a queue pair uniquely.
struct Mlx5DevxQpConnect {
  temporal:Temporal;
  dest_gid_prefix:uint64;
  dest_gid_iface:uint64;
  qp_num:uint32;
  dest_qp_num:uint32;
  dest_lid:uint32;
  src_lid:uint32;
  port_num:uint8;
}

// type 210, Entity. A queue pair created through mlx5dv_create_qp — an
// ordinary verbs queue pair reached by the mlx5 entry point, not a DEVX object.
// perftest creates its queue pairs this way and never calls ibv_create_qp.
struct Mlx5QueuePair {
  temporal:Temporal;
  qp:uint32;
  pd:uint32;
  qp_num:uint32;
  qp_type:uint8;
}

// type 212, Event. The GPU rang a doorbell. Emitted by the doorbell hijack even
// when the WQE cannot be read, so an undecodable doorbell is a visible row.
struct Mlx5Doorbell {
  temporal:Temporal;
  uar:uint32;          // joins Mlx5Uar
  qp_num:uint32;
  prod_idx:uint32;
}

// type 214, Event. A GPU-initiated send decoded from the WQE the doorbell
// announced. Same shape as IbPostSend so a reader can union device- and
// host-initiated sends.
struct Mlx5DeviceSend {
  temporal:Temporal;
  laddr:uint64;
  raddr:uint64;
  qp_num:uint32;
  wqe_idx:uint32;
  lkey:uint32;
  rkey:uint32;
  length:uint32;
  opcode:uint8;
}

// --- ucx/UCP provider records (600-699) -----------------------------------

// type 600, Entity. A public UCP context.
struct UcxContext {
  temporal:Temporal;
  context:uint32;
  api_major:uint32;
  api_minor:uint32;
}

// type 602, Entity. A worker owned by a UCP context.
struct UcxWorker {
  temporal:Temporal;
  worker:uint32;
  context:uint32;
}

// type 604, Entity. An endpoint owned by a UCP worker.
struct UcxEndpoint {
  temporal:Temporal;
  endpoint:uint32;
  worker:uint32;
}

// type 606, Event. A tagged-send intent; count is the raw UCP datatype count.
struct UcxTagSend {
  temporal:Temporal;
  endpoint:uint32;
  buffer:uint32;
  request:uint32;
  count:uint64;
  tag:uint64;
  status:int32;
  status_class:uint8;
  door:uint8;
  device:uint16;
}

// type 608, Event. A tagged receive POSTED — count is the capacity offered, not
// bytes delivered. Keyed by worker: the match is by tag across every peer.
struct UcxTagRecv {
  temporal:Temporal;
  worker:uint32;
  buffer:uint32;
  request:uint32;
  count:uint64;
  tag:uint64;
  tag_mask:uint64;
  message:uint32;
  status:int32;
  status_class:uint8;
  door:uint8;
}

// type 618, Event. A probe that FOUND a message. `length` is the one true byte
// count in the UCX family; `message` joins to UcxTagRecv.message (temporally —
// UCX recycles the handle).
struct UcxTagProbe {
  temporal:Temporal;
  worker:uint32;
  message:uint32;
  sender_tag:uint64;
  length:uint64;
  tag:uint64;
  tag_mask:uint64;
  removed:uint8;
}

// type 610, Event. A one-sided put or get; `op` discriminates (RmaOp).
struct UcxRma {
  temporal:Temporal;
  endpoint:uint32;
  buffer:uint32;
  request:uint32;
  rkey:uint32;
  count:uint64;
  remote_addr:uint64;
  status:int32;
  status_class:uint8;
  op:uint8;
  door:uint8;
  device:uint16;
}

// type 612, Event. An active-message send; header and payload keep separate
// lengths because one is control traffic and the other is data.
struct UcxAmSend {
  temporal:Temporal;
  endpoint:uint32;
  buffer:uint32;
  request:uint32;
  am_id:uint32;
  count:uint64;
  header_length:uint64;
  status:int32;
  status_class:uint8;
  device:uint16;
}

// type 614, Entity. A UCP memory registration. `resolved` says whether the
// address/length are the effective ones from ucp_mem_query or as requested.
struct UcxMemMap {
  temporal:Temporal;
  memh:uint32;
  context:uint32;
  address:uint64;
  length:uint64;
  resolved:uint8;
}

// type 616, Event. A worker progress call that progressed something. Full mode
// only, and telemetry rather than a golden — see the record.
struct UcxWorkerProgress {
  temporal:Temporal;
  worker:uint32;
  progressed:uint32;
}

// type 622, Artifact. This worker's own address as hashes. Two of them: the
// prefix is what a cross-rank join can use, the full one makes a prefix
// collision visible instead of silently wrong.
struct UcxWorkerAddress {
  temporal:Temporal;
  worker:uint32;
  addr_hash:uint64;
  prefix_hash:uint64;
  addr_len:uint32;
}

// type 624, Artifact. Which remote worker an endpoint was dialled at. Join to
// UcxWorkerAddress.prefix_hash from another rank's capture.
struct UcxEpConnection {
  temporal:Temporal;
  endpoint:uint32;
  remote_prefix_hash:uint64;
}

// type 626, Entity. A remote key, lifetime [ucp_ep_rkey_unpack,
// ucp_rkey_destroy). This is what ucx_rma.rkey and ucx_atomic.rkey join to;
// before it existed they named a handle nothing created. Carries no hash of the
// packed buffer on purpose — the unpack door takes no length and a packed rkey
// can be 9 bytes, so a fixed prefix would be an over-read that never matches.
// See the record for the full argument.
struct UcxRkey {
  temporal:Temporal;
  rkey:uint32;
  endpoint:uint32;
}

// type 628, Artifact. A registration was packed for export, i.e. made remotely
// accessible. `buffer_hash` covers the WHOLE buffer, which this side can do
// because ucp_rkey_pack returns the size.
struct UcxRkeyPack {
  temporal:Temporal;
  memh:uint32;
  context:uint32;
  buffer_hash:uint64;
  buffer_len:uint32;
}

// type 620, Event. A remote atomic. `op` is NORMALISED across the three UCX
// opcode spaces, which number the same operations differently — see
// UcxAtomicOp in providers/ucx/ucx_records.hpp.
struct UcxAtomic {
  temporal:Temporal;
  endpoint:uint32;
  buffer:uint32;
  request:uint32;
  rkey:uint32;
  value:uint64;
  remote_addr:uint64;
  op_size:uint64;
  status:int32;
  status_class:uint8;
  op:uint8;
  door:uint8;
  fetching:uint8;
}

// --- ucx_deep / UCT provider records (800-899) ------------------------------
// UCX's TRANSPORT layer, reached through uct_iface_ops_t — the dispatch table
// in uct/api/tl.h. On the HPC-X/mlx5 stack this is the ONLY layer of pcomm that
// sees the data plane at all: ib_post_send and mlx5_device_send are both empty
// there. See providers/ucx_deep/ucx_deep_records.hpp.

// type 800, Entity. One (transport, device) interface on a UCT worker.
// tl_name/dev_name are kNullHandle when the interface was opened by socket
// address rather than by device, where it genuinely has neither.
struct UctIface {
  temporal:Temporal;
  open_mode:uint64;
  iface:uint32;
  worker:uint32;
  md:uint32;
  tl_name:uint32;
  dev_name:uint32;
  instrumented:uint8;
  patched_ops:uint8;
  pad0:uint8;
  pad1:uint8;
}

// type 802, Entity. One UCT endpoint — a LANE of a ucp_ep, not a queue pair.
struct UctEndpoint {
  temporal:Temporal;
  ep:uint32;
  iface:uint32;
}

// type 804, Event. One UCT data operation. `payload` means something different
// per op family — sent, requested, or advertised — so it must not be summed
// across them; see UctOp in providers/ucx_deep/ucx_deep_records.hpp.
struct UctSend {
  temporal:Temporal;
  payload:uint64;
  header:uint64;
  remote_addr:uint64;
  tag:uint64;
  ep:uint32;
  iface:uint32;
  status:int32;
  op:uint8;
  iovcnt:uint8;
  pad0:uint8;
  pad1:uint8;
}

// type 806, Artifact. Which UCX this provider bound to, and whether the layout
// guard let it patch. `accepted = 0` is why uct_send is empty, and saying so is
// the whole reason this record exists.
struct UctBinding {
  temporal:Temporal;
  compiled_version:uint32;
  runtime_version:uint32;
  ops_size:uint32;
  accepted:uint8;
  forced:uint8;
  pad0:uint8;
  pad1:uint8;
}

// ---------------------------------------------------------------------------
// NCCL host API, 900-999. The collective layer as the application asked for it.
// Every temporal here is the HOST CALL, not the collective's execution — NCCL
// is stream-ordered, so these are enqueue facts. See
// providers/nccl/nccl_records.hpp.
// ---------------------------------------------------------------------------

// type 900, Entity. `comm_hash` is FNV-1a of the ncclUniqueId and is EQUAL on
// every rank of the communicator; the comm pointer is not, so the hash is the
// only cross-rank join.
//
// `nccl_comm_hash` is a different hash of the same identity and is NOT
// interchangeable with it: it is NCCL's own comm->commHash, recomputed by us,
// and it is the only name the profiler plugin is ever told — so it is the
// cross-LAYER join to nccl_prof_comm and nccl_coll_exec. 0 means NOT DERIVABLE
// (ncclCommSplit and the grow path mix their hash from a parent), never "no
// communicator"; a join on it must exclude 0 rather than match it.
struct NcclComm {
  temporal:Temporal;
  comm:uint32;
  comm_hash:uint64;
  nccl_comm_hash:uint64;
  rank:int32;
  nranks:int32;
  cuda_dev:int32;
  pad:int32;
}

// type 902, Event. `count` is ELEMENTS, not bytes, and the product with the
// datatype width is LOGICAL size — not what crosses the wire.
struct NcclCollective {
  temporal:Temporal;
  comm:uint32;
  sendbuff:uint32;
  recvbuff:uint32;
  stream:uint32;
  count:uint64;
  root:int32;
  op:uint8;
  datatype:uint8;
  redop:uint8;
  pad:uint8;
}

// type 904, Event. The only NCCL call that names a peer, and so the only one an
// exact edge follows from.
struct NcclP2p {
  temporal:Temporal;
  comm:uint32;
  buffer:uint32;
  stream:uint32;
  count:uint64;
  peer:int32;
  dir:uint8;
  datatype:uint8;
  pad:uint16;
}

// type 906, Event. Group boundaries: N grouped sends are ONE launch, and
// nothing in a send row says so.
struct NcclGroup {
  temporal:Temporal;
  depth:uint32;
  edge:uint32;
}

// type 908, Entity. A registered symmetric window — the host half of the
// device-initiated path, and what makes GPU-initiated NCCL attributable where
// case 05's internal channel buffers are not.
struct NcclWindow {
  temporal:Temporal;
  window:uint32;
  comm:uint32;
  buffer:uint32;
  size:uint64;
  win_flags:int32;
  pad:int32;
}

// type 910, Artifact. The existence fact "this workload initiates communication
// from the GPU". Nothing else in a capture states it: the device API is all
// NCCL_DEVICE_INLINE and leaves no symbol to interpose.
struct NcclDevComm {
  temporal:Temporal;
  comm:uint32;
  pad:int32;
}

// ---------------------------------------------------------------------------
// NCCL profiler plugin, 912-916. What NCCL DECIDED, from callbacks inside its
// own enqueue and proxy machinery — as opposed to 900-910 above, which is what
// the application asked for.
//
// These are a separate set of records rather than columns on the host-API rows
// because they come from a different mechanism at a different time: a run
// without NCCL_PROFILER_PLUGIN wired up has complete 900-910 tables and empty
// ones here, and a merged table could not say which of its columns were
// meaningful. See providers/nccl/nccl_records.hpp.
// ---------------------------------------------------------------------------

// type 912, Artifact. The bridge row: `nccl_comm_hash` is the value NCCL handed
// the plugin, and it joins to the identically-named column on NcclComm. Without
// it a profiler event names no communicator, rank layout or device.
struct NcclProfComm {
  temporal:Temporal;
  comm_name:uint32;
  nccl_comm_hash:uint64;
  nnodes:int32;
  nranks:int32;
  rank:int32;
  pad:int32;
}

// type 914, Event. The collective as NCCL executed it, carrying the algorithm
// and protocol it chose.
//
// THE TEMPORAL IS NOT NcclCollective's. That one is the duration of the host
// call — an enqueue. This one runs from NCCL's startEvent to its stopEvent for
// the collective itself. Reporting either as the other invents a number.
//
// `algo` and `proto` are NCCL's own strings, interned as given and never
// bucketed: the set is NCCL's to extend, and an unrecognised name must survive
// into the capture rather than collapse into "Other". They arrive UPPERCASED
// ("RING", "SIMPLE") while NCCL_ALGO/NCCL_PROTO are spelled mixed-case, so any
// comparison against what a run requested has to fold case.
//
// `root` is NCCL's value and NOT NcclCollective's convention: that record uses
// -1 for a rootless operation because 0 is a valid rank, while NCCL reports 0.
// The two records must not be compared on this column.
//
// `parent_event_id` is 0 for "parent not observed" — the parent's event family
// was not in the activation mask — and never for "root".
struct NcclCollExec {
  temporal:Temporal;
  func:uint32;
  algo:uint32;
  proto:uint32;
  datatype:uint32;
  nccl_comm_hash:uint64;
  event_id:uint64;
  parent_event_id:uint64;
  seq_number:uint64;
  count:uint64;
  root:int32;
  n_channels:uint8;
  n_warps:uint8;
  pad:uint16;
}

// type 916, Event. Where a collective becomes per-peer traffic: the finest
// granularity at which NCCL names a peer, linked to its collective by
// `parent_event_id` — NCCL's own linkage, not a reconstruction.
//
// n_steps * chunk_size is what NCCL PLANNED, not bytes a completion confirmed.
// Device-initiated traffic never reaches the CPU proxy and so has no row here.
// channel_id and is_send are widened to 32 bits rather than padded to the
// struct's alignment — the same trade NcclGroup's `edge` makes.
struct NcclProxyOp {
  temporal:Temporal;
  event_id:uint64;
  parent_event_id:uint64;
  peer:int32;
  n_steps:int32;
  chunk_size:int32;
  pid:int32;
  channel_id:uint32;
  is_send:uint32;
}

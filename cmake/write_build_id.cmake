# Write comshu_build_id.h — the identity of the tree this binary was built from.
#
# RUN AS A BUILD STEP, NOT AT CONFIGURE TIME, and that is the entire point.
# `configure_file` would stamp the commit once and then keep reporting it across
# every later rebuild, so a binary built from a tree three commits ahead would
# claim the commit someone last ran `cmake` on. A build id that goes stale is
# worse than no build id: it is a confident wrong answer, which is the exact
# failure mode records.hpp's Invocation comment describes (job 45331793).
#
# Only rewrites the file when the CONTENT changes, so an unchanged commit does
# not force a relink of everything downstream on every build.
#
# Invoked as:
#   cmake -DCOMSHU_SRC=<repo> -DCOMSHU_OUT=<header> -DCOMSHU_BUILD_TYPE=<cfg>
#         -P cmake/write_build_id.cmake
#
# with $COMSHU_COMMIT optionally overriding the git lookup (see below).

set(commit "unknown")
set(dirty "")

# $COMSHU_COMMIT wins, and it exists because the machines where provenance
# actually matters are the ones without a .git to ask. run_on_a100.sh RSYNCS the
# tree, so du04 holds a perfect copy of the source and no repository at all —
# every build there would otherwise stamp "unknown", on the one host where a
# hand-copied .so already caused a false refutation once.
#
# Read from the ENVIRONMENT at build time rather than from a cache variable at
# configure time, for this file's whole reason for existing: a cached commit
# goes stale the moment someone rebuilds without reconfiguring.
if(DEFINED ENV{COMSHU_COMMIT} AND NOT "$ENV{COMSHU_COMMIT}" STREQUAL "")
  set(commit "$ENV{COMSHU_COMMIT}")
endif()

find_package(Git QUIET)
if(commit STREQUAL "unknown" AND GIT_FOUND)
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${COMSHU_SRC}" rev-parse --short=12 HEAD
    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0 OR commit STREQUAL "")
    set(commit "unknown")
  endif()
  # A dirty tree is reported rather than hidden. run_on_a100.sh already refuses
  # to attribute a board to a commit when the tree is dirty; a capture should be
  # able to say the same thing about itself.
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${COMSHU_SRC}" status --porcelain --untracked-files=no
    OUTPUT_VARIABLE st OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(NOT st STREQUAL "")
    set(dirty "-dirty")
  endif()
endif()

set(body "// GENERATED by cmake/write_build_id.cmake on every build — do not edit, do not commit.
#pragma once
#define COMSHU_BUILD_COMMIT \"${commit}${dirty}\"
#define COMSHU_BUILD_TYPE   \"${COMSHU_BUILD_TYPE}\"
")

set(old "")
if(EXISTS "${COMSHU_OUT}")
  file(READ "${COMSHU_OUT}" old)
endif()
if(NOT old STREQUAL body)
  file(WRITE "${COMSHU_OUT}" "${body}")
endif()
